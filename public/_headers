# Cloudflare Pages response headers (copied into out/ by the build).
# https://developers.cloudflare.com/pages/configuration/headers/

# The same site is also served at the pages.dev address. Keep that copy out
# of search results so it never competes with stroop.lianhonglim.my.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Build files have a content hash in their name, so they never change:
# browsers can keep them for a year instead of re-checking every 4 hours.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Always use HTTPS for this site.
/*
  Strict-Transport-Security: max-age=31536000
